{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Article Frontmatter Schema",
  "description": "MDX 文章 Frontmatter JSON Schema 定义",
  "type": "object",
  "required": ["title", "description", "publishedAt", "tags", "category"],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "文章标题，用于 SEO title"
    },
    "description": {
      "type": "string",
      "minLength": 50,
      "maxLength": 200,
      "description": "文章摘要，用于 meta description"
    },
    "publishedAt": {
      "type": "string",
      "format": "date",
      "description": "发布日期（ISO 8601 格式：YYYY-MM-DD）"
    },
    "updatedAt": {
      "type": "string",
      "format": "date",
      "description": "最后更新日期，展示'最后更新'标签"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "标签数组，用于分类和筛选"
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "description": "分类名称（如：技术、生活、思考）"
    },
    "draft": {
      "type": "boolean",
      "default": false,
      "description": "草稿标记，true 时构建排除"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "精选标记，首页精选区展示"
    },
    "cover": {
      "type": "object",
      "required": ["src", "alt"],
      "properties": {
        "src": {
          "type": "string",
          "description": "封面图路径（相对路径或 URL）"
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "description": "封面图替代文本，无障碍必填"
        }
      },
      "additionalProperties": false
    },
    "toc": {
      "type": "boolean",
      "default": true,
      "description": "是否显示目录"
    },
    "readingTime": {
      "oneOf": [
        { "type": "number", "minimum": 1 },
        { "type": "string", "const": "auto" }
      ],
      "default": "auto",
      "description": "阅读时间（分钟），默认自动计算"
    }
  }
}
---
/**
 * @fileoverview 首页
 * @description PixelVerse 个人博客首页，包含 Hero、BentoGrid、社交链接等
 */

import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/layout/Header/Header.astro';
import Footer from '@components/layout/Footer/Footer.astro';
import Hero from '@components/layout/Hero/Hero.astro';
import BentoGrid from '@components/layout/BentoGrid';
import SocialLinks from '@components/social/SocialLinks';
import type { BentoItem } from '@components/layout/BentoGrid';
import type { SocialLinkItem } from '@components/social/SocialLinks';
import { formatDate } from '@utils/date';

// 获取所有非草稿文章
const allPosts = await getCollection('blog', ({ data }) => {
  return !data.draft;
});

// 按发布日期倒序排列
const posts = allPosts.sort((a, b) => {
  return new Date(b.data.publishedAt).valueOf() - new Date(a.data.publishedAt).valueOf();
});

// 作者数据
import authorData from '@data/author.json';
import socialData from '@data/social.json';

// BentoGrid 数据
const bentoItems: BentoItem[] = [
  {
    id: 'featured-post',
    title: '最新文章',
    description: posts[0]?.data.description || '暂无文章',
    icon: '📝',
    href: posts[0] ? `/blog/${posts[0].slug}` : '/blog',
    size: 'medium',
    tags: posts[0]?.data.tags?.slice(0, 2) || ['技术'],
  },
  {
    id: 'about',
    title: '关于我',
    description: '了解更多关于我的故事和项目',
    icon: '👋',
    href: '/about',
    size: 'small',
  },
  {
    id: 'projects',
    title: '项目',
    description: '浏览我的开源项目和作品',
    icon: '🚀',
    href: '/projects',
    size: 'small',
  },
  {
    id: 'tech-stack',
    title: '技术栈',
    description: 'Astro + React + MDX + Tailwind CSS',
    icon: '⚡',
    href: '/uses',
    size: 'small',
    tags: ['Astro', 'React', 'TypeScript'],
  },
  {
    id: 'newsletter',
    title: '订阅',
    description: '获取最新文章更新',
    icon: '📬',
    href: '/rss.xml',
    size: 'small',
  },
  {
    id: 'search',
    title: '搜索',
    description: '使用 Cmd+K 快速搜索全站内容',
    icon: '🔍',
    size: 'small',
    tags: ['Cmd+K'],
  },
];

// 社交链接数据
const socialLinks: SocialLinkItem[] = socialData.map((item: { name: string; url: string; icon: string; username: string }) => ({
  name: item.name,
  url: item.url,
  icon: item.icon,
  username: item.username,
}));
---

<BaseLayout
  title="首页"
  description="内容即体验的个人博客系统"
  articles={posts.map(post => ({
    slug: post.slug,
    title: post.data.title,
    description: post.data.description,
  }))}
  tags={[...new Set(posts.flatMap(post => post.data.tags))]}
>
  <Header slot="header" />

  <main class="min-h-screen">
    {/* Hero Section */}
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <Hero
        name={authorData.name}
        title={authorData.title}
        description={authorData.description}
        avatar={authorData.avatar}
        socialLinks={[
          { name: 'GitHub', url: 'https://github.com', icon: '🐙' },
          { name: 'Twitter', url: 'https://twitter.com', icon: '🐦' },
          { name: 'Email', url: 'mailto:hello@pixelverse.blog', icon: '📧' },
        ]}
      />
    </section>

    {/* BentoGrid Section */}
    <BentoGrid items={bentoItems} />

    {/* 最新文章列表 */}
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <h2 class="text-2xl font-bold text-text-primary mb-8">
        最新文章
      </h2>

      <div class="space-y-6">
        {posts.slice(0, 5).map((post) => (
          <article class="group p-6 bg-bg-secondary rounded-xl border border-border hover:border-accent/50 transition-colors">
            <a href={`/blog/${post.slug}`} class="block">
              <div class="flex items-center gap-3 text-sm text-text-tertiary mb-3">
                <span class="text-accent font-medium">{post.data.category}</span>
                <span>·</span>
                <time datetime={String(post.data.publishedAt)}>
                  {formatDate(post.data.publishedAt)}
                </time>
              </div>

              <h3 class="text-xl font-semibold text-text-primary group-hover:text-accent transition-colors mb-2">
                {post.data.title}
              </h3>

              <p class="text-text-secondary line-clamp-2">
                {post.data.description}
              </p>

              {post.data.tags && post.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-2 mt-3">
                  {post.data.tags.map((tag: string) => (
                    <span class="px-2 py-0.5 text-xs bg-bg-tertiary text-text-tertiary rounded">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </a>
          </article>
        ))}
      </div>

      {posts.length > 0 && (
        <div class="text-center mt-8">
          <a
            href="/blog"
            class="inline-block px-6 py-3 bg-bg-tertiary text-text-primary rounded-lg font-medium hover:bg-border transition-colors"
          >
            查看全部文章 →
          </a>
        </div>
      )}

      {posts.length === 0 && (
        <div class="text-center py-12 text-text-tertiary">
          暂无文章，敬请期待！
        </div>
      )}
    </section>

    {/* 社交链接 Section */}
    <section class="bg-bg-secondary py-12">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-text-primary text-center mb-8">
          关注我
        </h2>
        <div class="flex justify-center">
          <SocialLinks links={socialLinks} />
        </div>
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</BaseLayout>
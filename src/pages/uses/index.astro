---
/**
 * @fileoverview Uses 页面
 * @description 展示作者使用的工具和技术栈
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/layout/Header/Header.astro';
import Footer from '@components/layout/Footer/Footer.astro';

interface Tool {
  name: string;
  description: string;
  url?: string;
}

interface ToolCategory {
  name: string;
  tools: Tool[];
}

const categories: ToolCategory[] = [
  {
    name: '开发框架',
    tools: [
      { name: 'Astro', description: '内容驱动的 Web 框架', url: 'https://astro.build' },
      { name: 'React', description: 'UI 组件库', url: 'https://react.dev' },
      { name: 'TypeScript', description: '类型安全的 JavaScript', url: 'https://typescriptlang.org' },
    ],
  },
  {
    name: '样式与设计',
    tools: [
      { name: 'Tailwind CSS', description: '实用优先的 CSS 框架', url: 'https://tailwindcss.com' },
      { name: 'Framer Motion', description: '动画库', url: 'https://www.framer.com/motion' },
    ],
  },
  {
    name: '内容工具',
    tools: [
      { name: 'MDX', description: 'Markdown + JSX', url: 'https://mdxjs.com' },
      { name: 'Shiki', description: '代码语法高亮', url: 'https://shiki.style' },
      { name: 'Sandpack', description: '在线代码编辑器', url: 'https://sandpack.codesandbox.io' },
    ],
  },
  {
    name: '搜索与 SEO',
    tools: [
      { name: 'Pagefind', description: '静态站点搜索', url: 'https://pagefind.app' },
    ],
  },
];
---

<BaseLayout title="Uses" description="我使用的工具和技术栈">
  <Header slot="header" />

  <main class="min-h-screen">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      {/* 页面标题 */}
      <h1 class="text-3xl sm:text-4xl font-bold text-text-primary mb-4">
        Uses
      </h1>
      <p class="text-text-secondary mb-12">
        这是我用来构建和运行 PixelVerse 博客系统的工具和技术栈。
      </p>

      {/* 工具分类 */}
      {categories.map((category) => (
        <section class="mb-12">
          <h2 class="text-xl font-semibold text-text-primary mb-4">
            {category.name}
          </h2>
          <ul class="space-y-3">
            {category.tools.map((tool) => (
              <li class="flex items-start gap-3">
                <span class="text-accent mt-1" aria-hidden="true">→</span>
                <div>
                  {tool.url ? (
                    <a
                      href={tool.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-medium text-text-primary hover:text-accent transition-colors"
                    >
                      {tool.name}
                    </a>
                  ) : (
                    <span class="font-medium text-text-primary">{tool.name}</span>
                  )}
                  <p class="text-text-secondary text-sm">{tool.description}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>

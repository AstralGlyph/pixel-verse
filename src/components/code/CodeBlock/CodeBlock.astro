---
/**
 * @fileoverview CodeBlock 静态代码块组件
 * @description 使用 Shiki 进行编译时代码高亮的 Astro 组件
 */

export interface Props {
  /** 代码语言 */
  lang?: string;
  /** 文件名标签 */
  filename?: string;
  /** 高亮的行号（逗号分隔或范围如 "1-3,5"） */
  highlightLines?: string;
  /** 是否显示行号 */
  showLineNumbers?: boolean;
  /** 代码内容 */
  code: string;
}

const {
  lang = 'text',
  filename,
  highlightLines,
  showLineNumbers = false,
  code,
} = Astro.props;

// 解析高亮行号
function parseHighlightLines(str: string | undefined): Set<number> {
  if (!str) return new Set();
  const lines = new Set<number>();
  const parts = str.split(',');
  for (const part of parts) {
    const trimmed = part.trim();
    if (trimmed.includes('-')) {
      const [start, end] = trimmed.split('-').map((n) => parseInt(n.trim(), 10));
      for (let i = start; i <= end; i++) {
        lines.add(i);
      }
    } else {
      lines.add(parseInt(trimmed, 10));
    }
  }
  return lines;
}

const highlightedLines = parseHighlightLines(highlightLines);
const codeLines = code.split('\n');
---

<div class="my-6 group relative">
  {/* 文件名标签 */}
  {filename && (
    <div class="flex items-center gap-2 px-4 py-2 bg-bg-tertiary border border-border border-b-0 rounded-t-lg text-sm text-text-secondary">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
      <span>{filename}</span>
    </div>
  )}

  {/* 代码块容器 */}
  <div class:list={[
    "relative overflow-x-auto",
    filename ? "rounded-b-lg" : "rounded-lg",
    "border border-border bg-bg-secondary"
  ]}>
    {/* 复制按钮 */}
    <button
      type="button"
      class="copy-button absolute top-3 right-3 p-2 rounded-md bg-bg-tertiary border border-border text-text-secondary opacity-0 group-hover:opacity-100 transition-opacity hover:bg-bg hover:text-text-primary"
      aria-label="复制代码"
      data-code={code}
    >
      <svg class="h-4 w-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
      </svg>
      <svg class="h-4 w-4 check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
    </button>

    {/* 代码内容 */}
    <pre class:list={[
      "p-4 text-sm overflow-x-auto",
      showLineNumbers ? "pl-12" : ""
    ]}>
      <code class="font-mono" data-lang={lang}>
        {showLineNumbers ? (
          <table class="w-full border-collapse">
            <tbody>
              {codeLines.map((line, index) => {
                const lineNum = index + 1;
                const isHighlighted = highlightedLines.has(lineNum);
                return (
                  <tr class:list={["hover:bg-bg-tertiary/50 transition-colors", isHighlighted && "bg-highlight-bg"]}>
                    <td class="select-none text-right pr-4 text-text-tertiary text-xs w-8" aria-hidden="true">
                      {lineNum}
                    </td>
                    <td class="whitespace-pre">
                      {line || ' '}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        ) : (
          code
        )}
      </code>
    </pre>
  </div>
</div>

<script>
  // 复制功能
  document.querySelectorAll('.copy-button').forEach((button) => {
    button.addEventListener('click', async () => {
      const code = button.getAttribute('data-code') || '';
      try {
        await navigator.clipboard.writeText(code);
        // 显示成功图标
        const copyIcon = button.querySelector('.copy-icon');
        const checkIcon = button.querySelector('.check-icon');
        copyIcon?.classList.add('hidden');
        checkIcon?.classList.remove('hidden');
        // 2秒后恢复
        setTimeout(() => {
          copyIcon?.classList.remove('hidden');
          checkIcon?.classList.add('hidden');
        }, 2000);
      } catch (err) {
        console.error('复制失败:', err);
      }
    });
  });
</script>

<style>
  .bg-highlight-bg {
    background-color: var(--color-highlight-bg, rgba(255, 255, 0, 0.1));
  }
</style>
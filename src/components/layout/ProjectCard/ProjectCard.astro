---
/**
 * @fileoverview 项目卡片组件
 * @description 用于展示项目作品，包含标题、描述、技术栈和链接
 * @example
 * <ProjectCard
 *   title="项目名称"
 *   description="项目描述"
 *   tags={["TypeScript", "React"]}
 *   demoUrl="https://demo.example.com"
 *   sourceUrl="https://github.com/example"
 *   image="/images/projects/project.png"
 * />
 */

export interface Props {
  /** 项目名称 */
  title: string;
  /** 项目描述 */
  description: string;
  /** 技术栈标签 */
  tags?: string[];
  /** 演示地址 */
  demoUrl?: string;
  /** 源码地址 */
  sourceUrl?: string;
  /** 封面图片 */
  image?: string;
  /** 是否精选项目 */
  featured?: boolean;
}

const {
  title,
  description,
  tags = [],
  demoUrl,
  sourceUrl,
  image,
  featured = false,
} = Astro.props;
---

<article class:list={['project-card', featured && 'featured']}>
  {/* 封面图片 */}
  {image && (
    <div class="project-card-image">
      <img
        src={image}
        alt={`${title} 项目截图`}
        loading="lazy"
        class="w-full h-40 object-cover rounded-t-xl"
      />
    </div>
  )}

  <div class="p-5">
    {/* 标题 */}
    <h3 class="project-card-title">
      {title}
    </h3>

    {/* 描述 */}
    <p class="project-card-description">
      {description}
    </p>

    {/* 技术栈 */}
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-3">
        {tags.map((tag: string) => (
          <span class="project-tag">
            {tag}
          </span>
        ))}
      </div>
    )}

    {/* 链接 */}
    {(demoUrl || sourceUrl) && (
      <div class="flex gap-3 mt-4">
        {demoUrl && (
          <a
            href={demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="project-link project-link-primary"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            在线演示
          </a>
        )}
        {sourceUrl && (
          <a
            href={sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="project-link project-link-secondary"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
            </svg>
            源码
          </a>
        )}
      </div>
    )}
  </div>
</article>

<style>
  .project-card {
    @apply bg-bg-secondary rounded-xl border border-border overflow-hidden transition-all duration-200;
  }

  .project-card:hover {
    @apply border-accent shadow-lg;
  }

  .project-card.featured {
    @apply border-accent;
  }

  .project-card-title {
    @apply text-lg font-semibold text-text-primary mb-2;
  }

  .project-card-description {
    @apply text-text-secondary text-sm leading-relaxed;
  }

  .project-tag {
    @apply px-2 py-0.5 text-xs bg-bg-tertiary text-text-tertiary rounded;
  }

  .project-link {
    @apply flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium transition-colors;
  }

  .project-link-primary {
    @apply bg-accent text-white hover:opacity-90;
  }

  .project-link-secondary {
    @apply bg-bg-tertiary text-text-primary hover:bg-border;
  }
</style>

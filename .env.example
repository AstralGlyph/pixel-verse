# 环境变量配置
# 复制此文件为 .env.local 并填写实际值

# 站点 URL
SITE_URL=http://localhost:4321

# Giscus 评论配置
GISCUS_REPO=
GISCUS_REPO_ID=
GISCUS_CATEGORY=
GISCUS_CATEGORY_ID=

# Newsletter 配置 (可选)
NEWSLETTER_API_KEY=

# 分析工具 (可选)
ANALYTICS_ID=

# === Admin CMS 配置 ===

# 数据库
DATABASE_URL=file:./data/cms.db

# 会话密钥
SESSION_SECRET=change-this-to-a-random-secret-string

# 管理员初始账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com